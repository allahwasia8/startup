---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogListing from '../components/BlogListing.astro';
import Hero from '../components/Hero.astro';

const HOME_GRID_LIMIT = 12;

const allPosts = (await getCollection('blog')).sort((a, b) => {
  const aDate = new Date(a.data.date || '1970-01-01').getTime();
  const bDate = new Date(b.data.date || '1970-01-01').getTime();
  return bDate - aDate;
});

const featuredPost = allPosts[0] ?? null;
const gridPosts = allPosts.slice(1, 1 + HOME_GRID_LIMIT);
const categories = [...new Set(allPosts.map((post) => post.data.category || 'Insights'))].sort();

const site = Astro.site || new URL('https://ukstartupflow.com');
const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'UK Startup Flow',
      url: site.href,
      description:
        'Expert guidance, resources, and insights for starting, growing, and scaling a business in the UK.',
    },
    {
      '@type': 'Organization',
      name: 'UK Startup Flow',
      url: site.href,
      logo: new URL('/images/logo_final_transparent.png', site).href,
    },
  ],
};
---

<BaseLayout title="Home">
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} slot="head" />
  <Hero />
  <BlogListing
    featuredPost={featuredPost}
    gridPosts={gridPosts}
    categories={categories}
    heading="Latest Articles"
    headingLevel="h2"
    showResourcesLink={true}
    newsletterId="newsletter-email-home"
  />
</BaseLayout>
